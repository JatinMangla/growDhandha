# Public site URL — used for canonical tags, sitemap.xml, robots.txt and OG images.
# Local: http://localhost:3000  |  Production: your real domain (currently https://grow-dhandha-three.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format, digits only (no +, no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=919540151718

# Optional: Google Search Console verification token (leave blank if unused).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Umami Cloud website ID (cloud.umami.is → Settings → Websites).
# Unset = no analytics script loads at all. Set it in Production only.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional: email a copy of every contact-form enquiry (resend.com, free tier).
# Both must be set to switch it on. Server-only — never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender; must be a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=

# Optional: GitHub token (no scopes needed) to lift the API rate limit for the
# "Recently shipped" section on busy build machines. Server-only.
GITHUB_TOKEN=
